graph TD
    %% Main Entry
    Main[main.py] --> Router[TDocRouter]
    Main --> UI[ui_manager.py]
    
    %% UI interactions
    UI --> Router
    
    %% Routing Logic
    Router --> Factory[ServiceFactory]
    
    %% Services
    Factory --> Platform[PlatformService]
    Factory --> Network[NetworkService]
    Factory --> Security[SecurityService]
    Factory --> Updater[UpdaterService]
    Factory --> PkgMgr[PackageManagerService]
    Factory --> Util[UtilityService]
    
    %% Utility Tools
    Util --> Tools[htop/neofetch]
    
    %% Styles & Constants
    Router -.-> Const[constants.py]
    UI -.-> Theme[core/theme.py]

    subgraph Core
    Router
    Factory
    Const
    end

    subgraph Services
    Platform
    Network
    Security
    Updater
    PkgMgr
    Util
    end
    
    subgraph View
    UI
    Theme
    end
