graph TD
    %% Main Entry
    Main[main.py] --> Router[TDocRouter]
    Main --> HUD[HUDController]
    
    %% UI interactions
    HUD --> Router
    
    %% Routing Logic
    Router --> Factory[ServiceFactory]
    
    %% Services
    Factory --> Platform[PlatformService]
    Factory --> Network[NetworkService]
    Factory --> Security[SecurityService]
    Factory --> Updater[UpdaterService]
    Factory --> PkgMgr[PackageManagerService]
    Factory --> Util[UtilityService]
    Factory --> Config[ConfigService]
    Factory --> Persistence[PersistenceService]
    
    %% Utility Tools
    Util --> Tools[htop/neofetch]
    Util --> Robustness[robustness.py]
    
    %% Styles & Constants
    Router -.-> Const[constants.py]
    HUD -.-> Theme[core/theme.py]

    subgraph Core
    Router
    Factory
    Const
    Config
    Persistence
    end

    subgraph Services
    Platform
    Network
    Security
    Updater
    PkgMgr
    Util
    Robustness
    end
    
    subgraph View
    HUD
    Theme
    end
