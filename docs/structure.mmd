graph TD
    %% Main Entry
    Main[cmd/tdoc] --> Router[TDocRouter]
    Main --> HUD[HUDController]
    
    %% UI interactions
    HUD --> Router
    
    %% Routing Logic
    Router --> Factory[ServiceFactory]
    
    %% Services
    Factory --> Platform[PlatformService]
    Factory --> Network[NetworkService]
    Factory --> Security[SecurityService]
    Factory --> Util[UtilityService]
    Factory --> Config[ConfigService]
    Factory --> Cache[CacheLayer]
    
    %% Models
    Util --> Models[internal/models]
    
    %% Styles & Constants
    Router -.-> Const[constants]
    HUD -.-> Theme[internal/ui/theme]

    subgraph Core
    Router
    Factory
    Const
    Config
    Cache
    end

    subgraph Services
    Platform
    Network
    Security
    Util
    Models
    end
    
    subgraph View
    HUD
    Theme
    end
